# Optional: tighten CORS to specific origins instead of "*"
# Comma-separated list, e.g. "http://localhost:3000,https://your-frontend.app"
CORS_ALLOW_ORIGINS=*

# Optional: set to a stable secret so bearer tokens remain valid across restarts
# If not set, a random secret is used per process (tokens reset on restart).
AUTH_SECRET=change-me-to-a-long-random-secret
